                android:strokeColor="#222222"
                android:strokeLineCap="round"
                android:pathData="M0,0 Q30,-10 60,0" />
            <path
                android:strokeWidth="1.2"
                android:strokeColor="#555555"
                android:strokeLineCap="round"
                android:pathData="M60,0 L78,-12 M60,0 L80,-6 M60,0 L81,0 M60,0 L80,6 M60,0 L78,12 M60,0 L73,-16 M60,0 L73,16 M60,0 L68,-18 M60,0 L68,18" />
